{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Falcon Scale Station",
  "version": "0.2.3",
  "identifier": "com.falcongreenresources.scalestation.rs",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Falcon Scale Station",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#000000",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "../../resources/bin/plate-reader": "bin/plate-reader",
      "../../resources/plate-models/": "plate-models/"
    }
  }
}
